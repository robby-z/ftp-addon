#!/usr/bin/python3
"""Validate options, provision isolated users, and supervise vsftpd safely."""

from __future__ import annotations

import argparse
import ipaddress
import json
import logging
import mimetypes
import os
import re
import secrets
import shutil
import signal
import socket
import sqlite3
import ssl
import stat
import subprocess
import sys
import tempfile
import threading
import time
from contextlib import closing
from email.utils import formatdate
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from dataclasses import dataclass
from pathlib import Path, PurePosixPath
from typing import Any
from urllib.parse import parse_qs, quote, urlsplit

VERSION = "0.10.1"
RESERVED_USERS = {"root", "anonymous", "ftp", "nobody", "daemon", "bin", "sync"}
USERNAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")
PATH_SEGMENT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
MARKER_RE = re.compile(r"^\.[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
HOSTNAME_RE = re.compile(
    r"^(?=.{1,253}\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)*"
    r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.?$"
)
VIDEO_EXTENSIONS = {
    ".264", ".avi", ".h264", ".h265", ".hevc", ".m4v", ".mkv", ".mov",
    ".mp4", ".mpeg", ".mpg", ".ts", ".webm",
}
INDEX_SETTLE_SECONDS = 30
LOG = logging.getLogger("reolink-ftps")


class ConfigError(RuntimeError):
    """A safe, user-actionable configuration failure."""


@dataclass(frozen=True)
class User:
    username: str
    password: str
    directory: str
    read_only: bool


@dataclass(frozen=True)
class RuntimeConfig:
    raw: dict[str, Any]
    base: Path
    anchor: Path
    recording_root: Path
    users: tuple[User, ...]
    cert: Path
    key: Path
    cert_source: str


def atomic_write(path: Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def validated_relative(value: Any, label: str, *, minimum_parts: int = 1) -> PurePosixPath:
    if not isinstance(value, str) or not value or "\x00" in value or "\\" in value:
        raise ConfigError(f"{label} must be a non-empty relative POSIX path")
    raw_parts = value.split("/")
    if any(part in {"", ".", ".."} for part in raw_parts):
        raise ConfigError(f"{label} contains an unsafe path component")
    candidate = PurePosixPath(value)
    if candidate.is_absolute() or value.startswith("/"):
        raise ConfigError(f"{label} must not be an absolute path")
    if len(candidate.parts) < minimum_parts:
        raise ConfigError(f"{label} must contain at least {minimum_parts} path components")
    for part in candidate.parts:
        if part in {"", ".", ".."} or not PATH_SEGMENT_RE.fullmatch(part):
            raise ConfigError(f"{label} contains an unsafe path component: {part!r}")
    return candidate


def path_beneath(path: Path, parent: Path, label: str) -> None:
    try:
        path.relative_to(parent)
    except ValueError as err:
        raise ConfigError(f"{label} resolves outside {parent}") from err


def ensure_directory_chain(root: Path, relative: PurePosixPath, mode: int = 0o2770) -> Path:
    current = root
    for part in relative.parts:
        current = current / part
        if current.exists() or current.is_symlink():
            info = current.lstat()
            if stat.S_ISLNK(info.st_mode):
                raise ConfigError(f"Refusing symbolic link in storage path: {current}")
            if not stat.S_ISDIR(info.st_mode):
                raise ConfigError(f"Storage path component is not a directory: {current}")
        else:
            current.mkdir(mode=mode)
    resolved = current.resolve(strict=True)
    path_beneath(resolved, root.resolve(strict=True), "Storage directory")
    return resolved


def write_test(directory: Path) -> None:
    test_path: str | None = None
    try:
        fd, test_path = tempfile.mkstemp(prefix=".reolink-ftps-write-test-", dir=directory)
        with os.fdopen(fd, "wb") as handle:
            handle.write(b"storage-health-check\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.unlink(test_path)
    except OSError as err:
        if test_path:
            try:
                os.unlink(test_path)
            except OSError:
                pass
        raise ConfigError(f"Configured storage is not writable: {directory}: {err}") from err


def validate_users(raw_users: Any) -> tuple[User, ...]:
    if not isinstance(raw_users, list) or not raw_users:
        raise ConfigError("At least one FTP user with a non-empty password is required")
    result: list[User] = []
    names: set[str] = set()
    for index, item in enumerate(raw_users):
        if not isinstance(item, dict):
            raise ConfigError(f"users[{index}] must be an object")
        username = item.get("username")
        password = item.get("password")
        if not isinstance(username, str) or not USERNAME_RE.fullmatch(username):
            raise ConfigError(f"users[{index}].username contains unsafe characters")
        if username.lower() in RESERVED_USERS:
            raise ConfigError(f"Reserved FTP username is not allowed: {username}")
        if username in names:
            raise ConfigError(f"Duplicate FTP username: {username}")
        if not isinstance(password, str) or not password:
            raise ConfigError(f"Password for {username} must not be empty")
        if "\x00" in password or "\n" in password or "\r" in password:
            raise ConfigError(f"Password for {username} contains unsupported control characters")
        directory = str(validated_relative(item.get("directory"), f"Directory for {username}"))
        read_only = item.get("read_only", False)
        if not isinstance(read_only, bool):
            raise ConfigError(f"read_only for {username} must be true or false")
        names.add(username)
        result.append(User(username, password, directory, read_only))
    return tuple(result)


def validate_pasv_address(value: Any) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ConfigError(
            "pasv_address is required; set it to the Home Assistant LAN IP or hostname "
            "so cameras are never given the private container address"
        )
    value = value.strip()
    try:
        ipaddress.IPv4Address(value)
        return value
    except ipaddress.AddressValueError:
        if not HOSTNAME_RE.fullmatch(value):
            raise ConfigError("pasv_address must be an IPv4 address or valid DNS hostname")
        try:
            socket.getaddrinfo(value, None, socket.AF_INET, socket.SOCK_STREAM)
        except socket.gaierror as err:
            raise ConfigError(f"pasv_address hostname cannot be resolved: {value}") from err
        return value


def validate_tls(raw: Any, data_dir: Path, ssl_dir: Path) -> tuple[Path, Path, str]:
    if not isinstance(raw, dict):
        raise ConfigError("tls must be an object")
    require_tls = raw.get("require_tls")
    allow_plain = raw.get("allow_plain_ftp")
    if not isinstance(require_tls, bool) or not isinstance(allow_plain, bool):
        raise ConfigError("TLS flags must be true or false")
    if require_tls and allow_plain:
        raise ConfigError("tls.require_tls and tls.allow_plain_ftp cannot both be enabled")
    if not require_tls and not allow_plain:
        raise ConfigError("Plain FTP must be explicitly enabled when TLS is not required")
    certificate = raw.get("certificate", "")
    private_key = raw.get("private_key", "")
    if bool(certificate) != bool(private_key):
        raise ConfigError("Both tls.certificate and tls.private_key must be configured together")
    if certificate:
        cert_rel = validated_relative(certificate, "TLS certificate")
        key_rel = validated_relative(private_key, "TLS private key")
        try:
            ssl_root = ssl_dir.resolve(strict=True)
            cert = (ssl_dir / Path(*cert_rel.parts)).resolve(strict=True)
            key = (ssl_dir / Path(*key_rel.parts)).resolve(strict=True)
        except OSError as err:
            raise ConfigError("Configured TLS certificate or private key does not exist") from err
        path_beneath(cert, ssl_root, "TLS certificate")
        path_beneath(key, ssl_root, "TLS private key")
        source = "Home Assistant /ssl certificate"
    else:
        tls_dir = data_dir / "tls"
        if tls_dir.is_symlink():
            raise ConfigError("Persistent TLS directory must not be a symbolic link")
        tls_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        path_beneath(tls_dir.resolve(strict=True), data_dir.resolve(strict=True), "Persistent TLS directory")
        cert, key = tls_dir / "selfsigned.crt", tls_dir / "selfsigned.key"
        if not cert.exists() and not key.exists():
            LOG.info("Generating persistent self-signed TLS certificate")
            subprocess.run(
                [
                    "openssl", "req", "-x509", "-newkey", "rsa:3072", "-sha256",
                    "-days", "3650", "-nodes", "-subj", "/CN=Reolink FTPS Server",
                    "-keyout", str(key), "-out", str(cert),
                ],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                text=True,
            )
            key.chmod(0o600)
            cert.chmod(0o644)
        elif not cert.exists() or not key.exists():
            raise ConfigError("Persistent self-signed certificate pair is incomplete; restore or remove both files")
        source = "persistent self-signed certificate"
    validate_certificate_pair(cert, key)
    return cert, key, source


def validate_certificate_pair(cert: Path, key: Path) -> None:
    try:
        ssl.PEM_cert_to_DER_cert(cert.read_text(encoding="ascii"))
        cert_pub = subprocess.run(
            ["openssl", "x509", "-in", str(cert), "-pubkey", "-noout"],
            check=True, capture_output=True, text=True,
        ).stdout
        key_pub = subprocess.run(
            ["openssl", "pkey", "-in", str(key), "-pubout"],
            check=True, capture_output=True, text=True,
        ).stdout
    except (OSError, UnicodeError, ValueError, subprocess.CalledProcessError) as err:
        raise ConfigError("TLS certificate or private key is invalid") from err
    if cert_pub != key_pub:
        raise ConfigError("TLS certificate and private key do not match")


def prepare_runtime(
    raw: dict[str, Any], *, data_dir: Path, ssl_dir: Path,
    mapped_roots: dict[str, Path] | None = None,
) -> RuntimeConfig:
    storage = raw.get("storage")
    if not isinstance(storage, dict):
        raise ConfigError("storage must be an object")
    root_name = storage.get("root")
    if root_name not in {"media", "share"}:
        raise ConfigError("storage.root must be media or share")
    base = (mapped_roots or {"media": Path("/media"), "share": Path("/share")})[root_name]
    if not base.is_dir():
        raise ConfigError(f"Mapped storage root is unavailable: {base}")
    relative = validated_relative(storage.get("directory"), "storage.directory", minimum_parts=2)
    base_real = base.resolve(strict=True)
    anchor = base / relative.parts[0]
    if not anchor.exists() or anchor.is_symlink() or not anchor.is_dir():
        raise ConfigError(
            f"Configured recording storage {anchor} is unavailable. Refusing to start to prevent "
            "recordings from being written to the Home Assistant system disk."
        )
    anchor_real = anchor.resolve(strict=True)
    path_beneath(anchor_real, base_real, "Storage anchor")
    write_test(anchor_real)
    marker = storage.get("marker_file", ".reolink-storage")
    if not isinstance(marker, str) or not MARKER_RE.fullmatch(marker):
        raise ConfigError("storage.marker_file must be a safe hidden filename")
    marker_path = anchor_real / marker
    if storage.get("initialize_marker_file"):
        if marker_path.is_symlink():
            raise ConfigError(f"Marker file must not be a symbolic link: {marker_path}")
        marker_path.touch(mode=0o600, exist_ok=True)
        LOG.info("Storage marker initialized at %s", marker_path)
    if storage.get("require_marker_file") and (not marker_path.is_file() or marker_path.is_symlink()):
        raise ConfigError(f"Required storage marker is missing: {marker_path}")
    recording_relative = PurePosixPath(*relative.parts[1:])
    recording_root = ensure_directory_chain(anchor_real, recording_relative)
    write_test(recording_root)
    users = validate_users(raw.get("users"))
    for user in users:
        ensure_directory_chain(recording_root, PurePosixPath(user.directory))
    cert, key, source = validate_tls(raw.get("tls"), data_dir, ssl_dir)
    validate_pasv_address(raw.get("pasv_address"))
    validate_scalar_ranges(raw)
    return RuntimeConfig(raw, base_real, anchor_real, recording_root, users, cert, key, source)


def validate_scalar_ranges(raw: dict[str, Any]) -> None:
    ranges = {
        "max_clients": (1, 200), "max_per_ip": (1, 50),
        "idle_session_timeout": (60, 86400), "data_connection_timeout": (30, 3600),
        "delay_failed_login": (0, 30), "retention_days": (0, 3650),
    }
    for key, (minimum, maximum) in ranges.items():
        value = raw.get(key)
        if isinstance(value, bool) or not isinstance(value, int) or not minimum <= value <= maximum:
            raise ConfigError(f"{key} must be between {minimum} and {maximum}")
    storage = raw["storage"]
    for key in ("stop_uploads_below_free_space", "require_marker_file", "initialize_marker_file"):
        if not isinstance(storage.get(key), bool):
            raise ConfigError(f"storage.{key} must be true or false")
    minimum_free = storage.get("minimum_free_space_gb")
    if isinstance(minimum_free, bool) or not isinstance(minimum_free, int) or not 1 <= minimum_free <= 10000:
        raise ConfigError("storage.minimum_free_space_gb must be between 1 and 10000")


def allocate_uids(users: tuple[User, ...], data_dir: Path) -> dict[str, int]:
    path = data_dir / "user_uids.json"
    try:
        stored = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
    except (OSError, json.JSONDecodeError) as err:
        raise ConfigError(f"Cannot read persistent user UID map: {err}") from err
    valid = {k: v for k, v in stored.items() if isinstance(k, str) and isinstance(v, int) and 21000 <= v <= 60000}
    used = set(valid.values())
    next_uid = 21000
    for user in users:
        if user.username not in valid:
            while next_uid in used:
                next_uid += 1
            if next_uid > 60000:
                raise ConfigError("No container UID is available for another FTP user")
            valid[user.username] = next_uid
            used.add(next_uid)
    atomic_write(path, json.dumps(valid, sort_keys=True, indent=2) + "\n")
    return {user.username: valid[user.username] for user in users}


def run_quiet(command: list[str], *, input_text: str | None = None) -> None:
    try:
        subprocess.run(command, input=input_text, text=True, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except subprocess.CalledProcessError as err:
        raise ConfigError(f"Container account provisioning failed while running {command[0]}") from err


def configure_storage_permissions(
    recording_root: Path, homes: tuple[Path, ...], *, group_gid: int = 20000, owner_uid: int = 0,
) -> None:
    """Allow FTP users to traverse app-managed parents and write only in their homes."""
    root = recording_root.resolve(strict=True)
    home_set = {home.resolve(strict=True) for home in homes}
    managed = {root}
    for home in home_set:
        path_beneath(home, root, "FTP home directory")
        current = home
        while current != root:
            managed.add(current)
            current = current.parent
    for directory in sorted(managed, key=lambda path: len(path.parts)):
        os.chown(directory, owner_uid, group_gid)
        os.chmod(directory, 0o2770 if directory in home_set else 0o2710)


def provision_users(config: RuntimeConfig, data_dir: Path, runtime_dir: Path) -> None:
    try:
        subprocess.run(["getent", "group", "reolinkftp"], check=True, stdout=subprocess.DEVNULL)
    except subprocess.CalledProcessError:
        run_quiet(["groupadd", "-g", "20000", "reolinkftp"])
    uids = allocate_uids(config.users, data_dir)
    shells = Path("/etc/shells")
    if shells.exists() and "/sbin/nologin" not in shells.read_text(encoding="utf-8").splitlines():
        with shells.open("a", encoding="utf-8") as handle:
            handle.write("/sbin/nologin\n")
    homes = {
        user.username: ensure_directory_chain(config.recording_root, PurePosixPath(user.directory))
        for user in config.users
    }
    configure_storage_permissions(config.recording_root, tuple(homes.values()))
    for user in config.users:
        home = homes[user.username]
        try:
            subprocess.run(["id", user.username], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except subprocess.CalledProcessError:
            run_quiet([
                "useradd", "--uid", str(uids[user.username]), "--gid", "reolinkftp", "--no-create-home",
                "--home-dir", str(home), "--shell", "/sbin/nologin", user.username,
            ])
        run_quiet(["usermod", "--home", str(home), user.username])

    password_lines = []
    for user in config.users:
        result = subprocess.run(
            ["openssl", "passwd", "-6", "-stdin"], input=user.password + "\n",
            text=True, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        )
        password_lines.append(f"{user.username}:{result.stdout.strip()}")
    atomic_write(runtime_dir / "users.passwd", "\n".join(password_lines) + "\n", 0o600)
    atomic_write(
        Path("/etc/pam.d/reolink-ftps"),
        f"auth required pam_pwdfile.so pwdfile={runtime_dir / 'users.passwd'}\n"
        "account required pam_permit.so\n",
        0o600,
    )


def build_vsftpd_config(
    config: RuntimeConfig, runtime_dir: Path, user_config_dir: Path = Path("/etc/vsftpd/users"),
) -> Path:
    raw, tls = config.raw, config.raw["tls"]
    pasv = validate_pasv_address(raw["pasv_address"])
    is_hostname = not _is_ipv4(pasv)
    lines = [
        "listen=YES", "listen_ipv6=NO", "anonymous_enable=NO", "local_enable=YES",
        "write_enable=YES", "local_umask=0007", "file_open_mode=0660", "dirmessage_enable=NO", "use_localtime=YES",
        "connect_from_port_20=NO", "chroot_local_user=YES", "allow_writeable_chroot=YES",
        "hide_ids=YES", "ls_recurse_enable=NO", "seccomp_sandbox=NO", "isolate_network=NO",
        "pam_service_name=reolink-ftps",
        "secure_chroot_dir=/run/vsftpd/empty",
        f"user_config_dir={user_config_dir}", "ssl_enable=YES", "allow_anon_ssl=NO",
        f"force_local_logins_ssl={'YES' if tls['require_tls'] else 'NO'}",
        f"force_local_data_ssl={'YES' if tls['require_tls'] else 'NO'}",
        "ssl_sslv2=NO", "ssl_sslv3=NO", "ssl_tlsv1=YES", "require_ssl_reuse=NO",
        "ssl_ciphers=HIGH:!aNULL:!MD5:!3DES:!CAMELLIA", f"rsa_cert_file={config.cert}",
        f"rsa_private_key_file={config.key}", "pasv_enable=YES", "pasv_min_port=30000",
        "pasv_max_port=30019", f"pasv_address={pasv}",
        f"pasv_addr_resolve={'YES' if is_hostname else 'NO'}", f"max_clients={raw['max_clients']}",
        f"max_per_ip={raw['max_per_ip']}", f"idle_session_timeout={raw['idle_session_timeout']}",
        f"data_connection_timeout={raw['data_connection_timeout']}",
        f"delay_failed_login={raw['delay_failed_login']}", "background=NO", "log_ftp_protocol=NO",
        "xferlog_enable=NO", "dual_log_enable=NO", "syslog_enable=NO",
    ]
    config_path = runtime_dir / "vsftpd.conf"
    atomic_write(config_path, "\n".join(lines) + "\n")
    user_dir = user_config_dir
    user_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    for old in user_dir.iterdir():
        if old.is_file() and old.name not in {u.username for u in config.users}:
            old.unlink()
    for user in config.users:
        local_root = ensure_directory_chain(config.recording_root, PurePosixPath(user.directory))
        per_user = [f"local_root={local_root}", f"write_enable={'NO' if user.read_only else 'YES'}"]
        atomic_write(user_dir / user.username, "\n".join(per_user) + "\n")
    return config_path


def _is_ipv4(value: str) -> bool:
    try:
        ipaddress.IPv4Address(value)
        return True
    except ipaddress.AddressValueError:
        return False


def free_bytes(path: Path) -> int:
    return shutil.disk_usage(path).free


def remove_expired_files(root: Path, days: int) -> tuple[int, int]:
    if days <= 0:
        return 0, 0
    root_real = root.resolve(strict=True)
    cutoff = time.time() - days * 86400
    removed = reclaimed = 0
    for current, dirs, files in os.walk(root_real, topdown=True, followlinks=False):
        current_path = Path(current)
        dirs[:] = [name for name in dirs if not (current_path / name).is_symlink()]
        path_beneath(current_path.resolve(strict=True), root_real, "Retention path")
        for name in files:
            path = current_path / name
            try:
                info = path.lstat()
                if stat.S_ISREG(info.st_mode) and info.st_mtime < cutoff:
                    path.unlink()
                    removed += 1
                    reclaimed += info.st_size
            except FileNotFoundError:
                continue
    return removed, reclaimed


class BrowserRequestError(RuntimeError):
    """An expected, safe HTTP browser error."""

    def __init__(self, status: int, message: str, *, total_size: int | None = None):
        super().__init__(message)
        self.status = status
        self.total_size = total_size


def browser_user_roots(config: RuntimeConfig) -> dict[str, Path]:
    roots: dict[str, Path] = {}
    recording_root = config.recording_root.resolve(strict=True)
    for user in config.users:
        root = (recording_root / user.directory).resolve(strict=True)
        path_beneath(root, recording_root, "Browser user directory")
        roots[user.username] = root
    return roots


def browser_camera_roots(config: RuntimeConfig) -> dict[str, Path]:
    """Return one representative camera account for each physical user root."""
    selected: dict[Path, User] = {}
    recording_root = config.recording_root.resolve(strict=True)
    for user in config.users:
        root = (recording_root / user.directory).resolve(strict=True)
        path_beneath(root, recording_root, "Browser camera directory")
        current = selected.get(root)
        if current is None or (current.read_only and not user.read_only):
            selected[root] = user
    return {user.username: root for root, user in selected.items()}


def is_video_file(path: Path) -> bool:
    return path.suffix.casefold() in VIDEO_EXTENSIONS


def resolve_browser_path(root: Path, relative: str, *, expected: str | None = None) -> Path:
    if not isinstance(relative, str) or "\x00" in relative or "\\" in relative or relative.startswith("/"):
        raise BrowserRequestError(400, "Invalid relative path")
    parts = [] if relative == "" else relative.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        raise BrowserRequestError(400, "Invalid path component")
    current = root
    try:
        for part in parts:
            current = current / part
            info = current.lstat()
            if stat.S_ISLNK(info.st_mode):
                raise BrowserRequestError(404, "Path not found")
        resolved = current.resolve(strict=True)
        resolved.relative_to(root)
    except (FileNotFoundError, NotADirectoryError, ValueError):
        raise BrowserRequestError(404, "Path not found") from None
    if expected == "directory" and not resolved.is_dir():
        raise BrowserRequestError(404, "Directory not found")
    if expected == "file" and not resolved.is_file():
        raise BrowserRequestError(404, "File not found")
    return resolved


def list_browser_directory(root: Path, relative: str) -> list[dict[str, Any]]:
    directory = resolve_browser_path(root, relative, expected="directory")
    entries: list[dict[str, Any]] = []
    try:
        children = list(directory.iterdir())
    except OSError as err:
        raise BrowserRequestError(500, f"Directory cannot be read: {err.strerror or err}") from err
    for child in children:
        try:
            info = child.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(info.st_mode):
            continue
        is_directory = stat.S_ISDIR(info.st_mode)
        if not is_directory and not stat.S_ISREG(info.st_mode):
            continue
        child_relative = "/".join(filter(None, (relative, child.name)))
        mime = None if is_directory else (mimetypes.guess_type(child.name)[0] or "application/octet-stream")
        entries.append({
            "name": child.name,
            "path": child_relative,
            "type": "directory" if is_directory else "file",
            "size": None if is_directory else info.st_size,
            "modified": int(info.st_mtime),
            "mime": mime,
        })
    entries.sort(key=lambda item: (item["type"] != "directory", item["name"].casefold()))
    return entries


def parse_byte_range(value: str | None, size: int) -> tuple[int, int, bool]:
    if not value:
        return 0, max(0, size - 1), False
    if not value.startswith("bytes=") or "," in value or size <= 0:
        raise BrowserRequestError(416, "Invalid byte range", total_size=size)
    spec = value[6:].strip()
    try:
        start_text, end_text = spec.split("-", 1)
        if not start_text:
            length = int(end_text)
            if length <= 0:
                raise ValueError
            start = max(0, size - length)
            end = size - 1
        else:
            start = int(start_text)
            end = int(end_text) if end_text else size - 1
            if start < 0 or end < start or start >= size:
                raise ValueError
            end = min(end, size - 1)
    except (ValueError, TypeError):
        raise BrowserRequestError(416, "Invalid byte range", total_size=size) from None
    return start, end, True


class RecordingIndex:
    """Persistent, rebuildable metadata index for recording table queries."""

    SORT_COLUMNS = {
        "modified": "modified", "name": "name COLLATE NOCASE", "size": "size",
        "camera": "camera COLLATE NOCASE", "path": "relative_path COLLATE NOCASE",
    }

    def __init__(
        self, path: Path, sources: dict[str, Path], *, scan_interval: int = 60,
        settle_seconds: int = INDEX_SETTLE_SECONDS,
    ):
        self.path = path
        self.sources = sources
        self.scan_interval = scan_interval
        self.settle_seconds = settle_seconds
        self.stop_event = threading.Event()
        self.wake_event = threading.Event()
        self.lock = threading.Lock()
        self.scanning = False
        self.last_scan: int | None = None
        self.last_error: str | None = None
        self.thread: threading.Thread | None = None
        self._initialize()

    def _connect(self) -> sqlite3.Connection:
        connection = sqlite3.connect(self.path, timeout=10)
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA busy_timeout = 10000")
        return connection

    def _initialize(self) -> None:
        self.path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            self._initialize_database()
        except sqlite3.DatabaseError:
            LOG.warning("Discarding corrupt recording metadata index; it will be rebuilt")
            for suffix in ("", "-wal", "-shm"):
                try:
                    Path(f"{self.path}{suffix}").unlink()
                except FileNotFoundError:
                    pass
            self._initialize_database()
        self.path.chmod(0o600)

    def _initialize_database(self) -> None:
        with closing(self._connect()) as connection, connection:
            connection.execute("PRAGMA journal_mode = WAL")
            version = connection.execute("PRAGMA user_version").fetchone()[0]
            if version not in (0, 1):
                connection.execute("DROP TABLE IF EXISTS recordings")
            connection.execute(
                """
                CREATE TABLE IF NOT EXISTS recordings (
                    camera TEXT NOT NULL,
                    relative_path TEXT NOT NULL,
                    name TEXT NOT NULL,
                    directory TEXT NOT NULL,
                    size INTEGER NOT NULL,
                    modified_ns INTEGER NOT NULL,
                    modified INTEGER NOT NULL,
                    mime TEXT NOT NULL,
                    seen_scan INTEGER NOT NULL,
                    PRIMARY KEY (camera, relative_path)
                )
                """
            )
            connection.execute(
                "CREATE INDEX IF NOT EXISTS recordings_modified ON recordings(modified DESC)"
            )
            connection.execute(
                "CREATE INDEX IF NOT EXISTS recordings_camera_modified ON recordings(camera, modified DESC)"
            )
            connection.execute("PRAGMA user_version = 1")

    def start(self) -> None:
        self.thread = threading.Thread(target=self._run, name="recording-index", daemon=True)
        self.thread.start()

    def stop(self) -> None:
        self.stop_event.set()
        self.wake_event.set()
        if self.thread:
            self.thread.join(timeout=10)

    def refresh(self) -> None:
        self.wake_event.set()

    def _run(self) -> None:
        while not self.stop_event.is_set():
            with self.lock:
                self.scanning = True
                self.last_error = None
            try:
                self._scan_all()
                with self.lock:
                    self.last_scan = int(time.time())
            except Exception as err:
                LOG.exception("Recording index scan failed")
                with self.lock:
                    self.last_error = str(err)
            finally:
                with self.lock:
                    self.scanning = False
            self.wake_event.wait(self.scan_interval)
            self.wake_event.clear()

    def _scan_all(self) -> None:
        cutoff = time.time() - self.settle_seconds
        def raise_walk_error(error: OSError) -> None:
            raise error

        for camera, root in self.sources.items():
            if not root.is_dir() or root.is_symlink():
                raise OSError(f"Camera recording root is unavailable: {root}")
            scan_token = time.time_ns()
            batch: list[tuple[Any, ...]] = []
            for current, directories, files in os.walk(
                root, topdown=True, onerror=raise_walk_error, followlinks=False,
            ):
                current_path = Path(current)
                directories[:] = [
                    name for name in directories
                    if not (current_path / name).is_symlink()
                ]
                for name in files:
                    path = current_path / name
                    if not is_video_file(path):
                        continue
                    try:
                        info = path.lstat()
                    except FileNotFoundError:
                        continue
                    if not stat.S_ISREG(info.st_mode) or info.st_mtime > cutoff:
                        continue
                    relative = path.relative_to(root).as_posix()
                    batch.append((
                        camera, relative, name, str(PurePosixPath(relative).parent), info.st_size,
                        info.st_mtime_ns, int(info.st_mtime),
                        mimetypes.guess_type(name)[0] or "video/mp4", scan_token,
                    ))
                    if len(batch) >= 500:
                        self._upsert(batch)
                        batch.clear()
            if batch:
                self._upsert(batch)
            with closing(self._connect()) as connection, connection:
                connection.execute(
                    "DELETE FROM recordings WHERE camera = ? AND seen_scan != ?", (camera, scan_token),
                )
        cameras = tuple(self.sources)
        with closing(self._connect()) as connection, connection:
            if cameras:
                placeholders = ",".join("?" for _ in cameras)
                connection.execute(
                    f"DELETE FROM recordings WHERE camera NOT IN ({placeholders})", cameras,
                )
            else:
                connection.execute("DELETE FROM recordings")

    def _upsert(self, rows: list[tuple[Any, ...]]) -> None:
        with closing(self._connect()) as connection, connection:
            connection.executemany(
                """
                INSERT INTO recordings (
                    camera, relative_path, name, directory, size, modified_ns, modified, mime, seen_scan
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(camera, relative_path) DO UPDATE SET
                    name = excluded.name,
                    directory = excluded.directory,
                    size = excluded.size,
                    modified_ns = excluded.modified_ns,
                    modified = excluded.modified,
                    mime = excluded.mime,
                    seen_scan = excluded.seen_scan
                """,
                rows,
            )

    @staticmethod
    def _search_pattern(value: str) -> str:
        escaped = value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
        return f"%{escaped}%"

    def query(
        self, *, camera: str = "", search: str = "", from_time: int | None = None,
        to_time: int | None = None, sort: str = "modified", direction: str = "desc",
        page: int = 1, page_size: int = 100,
    ) -> dict[str, Any]:
        if camera and camera not in self.sources:
            raise BrowserRequestError(400, "Unknown camera filter")
        if sort not in self.SORT_COLUMNS or direction not in {"asc", "desc"}:
            raise BrowserRequestError(400, "Invalid sort order")
        if not 1 <= page_size <= 200 or page < 1:
            raise BrowserRequestError(400, "Invalid page")
        conditions: list[str] = []
        parameters: list[Any] = []
        if camera:
            conditions.append("camera = ?")
            parameters.append(camera)
        if search:
            conditions.append("(name LIKE ? ESCAPE '\\' OR relative_path LIKE ? ESCAPE '\\')")
            pattern = self._search_pattern(search)
            parameters.extend((pattern, pattern))
        if from_time is not None:
            conditions.append("modified >= ?")
            parameters.append(from_time)
        if to_time is not None:
            conditions.append("modified <= ?")
            parameters.append(to_time)
        where = f"WHERE {' AND '.join(conditions)}" if conditions else ""
        order = self.SORT_COLUMNS[sort]
        offset = (page - 1) * page_size
        with closing(self._connect()) as connection, connection:
            total = connection.execute(
                f"SELECT COUNT(*) FROM recordings {where}", parameters,
            ).fetchone()[0]
            rows = connection.execute(
                f"""
                SELECT camera, relative_path, name, directory, size, modified, mime
                FROM recordings {where}
                ORDER BY {order} {direction.upper()}, relative_path COLLATE NOCASE ASC
                LIMIT ? OFFSET ?
                """,
                (*parameters, page_size, offset),
            ).fetchall()
        pages = max(1, (total + page_size - 1) // page_size)
        return {
            "items": [dict(row) for row in rows], "total": total, "page": page,
            "page_size": page_size, "pages": pages, "status": self.status(),
        }

    def indexed(self, camera: str, relative: str) -> bool:
        with closing(self._connect()) as connection, connection:
            return connection.execute(
                "SELECT 1 FROM recordings WHERE camera = ? AND relative_path = ?",
                (camera, relative),
            ).fetchone() is not None

    def remove(self, camera: str, relative: str) -> None:
        with closing(self._connect()) as connection, connection:
            connection.execute(
                "DELETE FROM recordings WHERE camera = ? AND relative_path = ?", (camera, relative),
            )

    def status(self) -> dict[str, Any]:
        with self.lock:
            scanning, last_scan, error = self.scanning, self.last_scan, self.last_error
        with closing(self._connect()) as connection, connection:
            count = connection.execute("SELECT COUNT(*) FROM recordings").fetchone()[0]
        return {"scanning": scanning, "last_scan": last_scan, "error": error, "files": count}


class RecordingBrowser:
    """Home Assistant Ingress-only recording browser and recording manager."""

    def __init__(
        self, config: RuntimeConfig, *, host: str = "0.0.0.0", port: int = 8099,
        allowed_clients: set[str] | None = None, index_path: Path = Path("/usr/local/share/reolink-ftps/index.html"),
        data_dir: Path = Path("/data"), scan_interval: int = 60,
    ):
        self.config = config
        self.host = host
        self.port = port
        self.allowed_clients = {"172.30.32.2"} if allowed_clients is None else allowed_clients
        self.index_html = index_path.read_text(encoding="utf-8")
        self.user_roots = browser_user_roots(config)
        self.camera_roots = browser_camera_roots(config)
        self.index = RecordingIndex(
            data_dir / "recordings-index.sqlite3", self.camera_roots, scan_interval=scan_interval,
        )
        self.csrf_token = secrets.token_urlsafe(32)
        self.server: ThreadingHTTPServer | None = None
        self.thread: threading.Thread | None = None

    def _handler(self) -> type[BaseHTTPRequestHandler]:
        browser = self

        class Handler(BaseHTTPRequestHandler):
            server_version = f"ReolinkRecordingBrowser/{VERSION}"
            sys_version = ""
            protocol_version = "HTTP/1.1"

            def log_message(self, format_string: str, *args: object) -> None:
                LOG.debug("Ingress %s - %s", self.client_address[0], format_string % args)

            def do_HEAD(self) -> None:
                self._dispatch(head_only=True)

            def do_GET(self) -> None:
                self._dispatch(head_only=False)

            def do_POST(self) -> None:
                self._dispatch(head_only=False, post=True)

            def _dispatch(self, *, head_only: bool, post: bool = False) -> None:
                try:
                    if self.client_address[0] not in browser.allowed_clients:
                        raise BrowserRequestError(403, "Ingress access only")
                    request = urlsplit(self.path)
                    if request.path in {"", "/"}:
                        self._serve_index(head_only)
                    elif request.path == "/api/meta":
                        self._serve_json({
                            "cameras": list(browser.camera_roots),
                            "csrf_token": browser.csrf_token,
                            "status": browser.index.status(),
                        }, head_only)
                    elif request.path == "/api/recordings":
                        query = parse_qs(request.query, keep_blank_values=True)
                        search = self._one(query, "q", default="").strip()
                        if len(search) > 200:
                            raise BrowserRequestError(400, "Search is too long")
                        result = browser.index.query(
                            camera=self._one(query, "camera", default=""),
                            search=search,
                            from_time=self._integer(query, "from", default=None),
                            to_time=self._integer(query, "to", default=None),
                            sort=self._one(query, "sort", default="modified"),
                            direction=self._one(query, "direction", default="desc"),
                            page=self._integer(query, "page", default=1) or 1,
                            page_size=self._integer(query, "page_size", default=100) or 100,
                        )
                        self._serve_json(result, head_only)
                    elif request.path == "/api/users":
                        self._serve_json({"users": [
                            {"username": user.username, "directory": user.directory}
                            for user in browser.config.users
                        ]}, head_only)
                    elif request.path == "/api/list":
                        query = parse_qs(request.query, keep_blank_values=True)
                        user, root = self._user(query)
                        relative = self._one(query, "path", default="")
                        self._serve_json({
                            "user": user, "path": relative,
                            "entries": list_browser_directory(root, relative),
                        }, head_only)
                    elif request.path == "/media":
                        query = parse_qs(request.query, keep_blank_values=True)
                        _user, root = self._user(query)
                        relative = self._one(query, "path")
                        self._serve_file(resolve_browser_path(root, relative, expected="file"), head_only)
                    elif request.path == "/api/refresh" and post:
                        self._require_csrf()
                        browser.index.refresh()
                        self._serve_json({"refreshing": True}, head_only)
                    elif request.path == "/api/delete" and post:
                        self._require_csrf()
                        query = parse_qs(request.query, keep_blank_values=True)
                        camera = self._one(query, "camera")
                        relative = self._one(query, "path")
                        browser.delete_recording(camera, relative)
                        self._serve_json({"deleted": True}, head_only)
                    else:
                        raise BrowserRequestError(404, "Not found")
                except BrowserRequestError as err:
                    self._serve_json(
                        {"error": str(err)}, head_only, status=err.status, range_total=err.total_size,
                    )
                except (BrokenPipeError, ConnectionResetError):
                    return
                except Exception:
                    LOG.exception("Unexpected recording browser request failure")
                    self._serve_json({"error": "Internal server error"}, head_only, status=500)

            @staticmethod
            def _one(query: dict[str, list[str]], key: str, *, default: str | None = None) -> str:
                values = query.get(key)
                if not values:
                    if default is not None:
                        return default
                    raise BrowserRequestError(400, f"Missing {key}")
                if len(values) != 1:
                    raise BrowserRequestError(400, f"Invalid {key}")
                return values[0]

            @classmethod
            def _integer(
                cls, query: dict[str, list[str]], key: str, *, default: int | None,
            ) -> int | None:
                value = cls._one(query, key, default="" if default is None else str(default))
                if value == "":
                    return None
                try:
                    return int(value)
                except ValueError:
                    raise BrowserRequestError(400, f"Invalid {key}") from None

            def _require_csrf(self) -> None:
                supplied = self.headers.get("X-Reolink-CSRF", "")
                if not secrets.compare_digest(supplied, browser.csrf_token):
                    raise BrowserRequestError(403, "Invalid request token")

            def _user(self, query: dict[str, list[str]]) -> tuple[str, Path]:
                username = self._one(query, "user")
                root = browser.user_roots.get(username)
                if root is None:
                    raise BrowserRequestError(404, "Unknown user")
                return username, root

            def _security_headers(self) -> None:
                self.send_header("X-Content-Type-Options", "nosniff")
                self.send_header("X-Frame-Options", "SAMEORIGIN")
                self.send_header("Referrer-Policy", "no-referrer")
                self.send_header(
                    "Content-Security-Policy",
                    "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; "
                    "style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors 'self'",
                )

            def _serve_index(self, head_only: bool) -> None:
                ingress_path = self.headers.get("X-Ingress-Path", "")
                if not re.fullmatch(r"/[A-Za-z0-9/_-]{0,511}", ingress_path):
                    ingress_path = ""
                body = browser.index_html.replace("__INGRESS_PATH__", json.dumps(ingress_path)).encode("utf-8")
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self._security_headers()
                self.end_headers()
                if not head_only:
                    self.wfile.write(body)

            def _serve_json(
                self, value: Any, head_only: bool, *, status: int = 200, range_total: int | None = None,
            ) -> None:
                body = json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.send_header("Cache-Control", "no-store")
                self._security_headers()
                if status == 416:
                    self.send_header("Content-Range", f"bytes */{max(0, range_total or 0)}")
                self.end_headers()
                if not head_only:
                    self.wfile.write(body)

            def _serve_file(self, path: Path, head_only: bool) -> None:
                handle = None
                try:
                    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
                    try:
                        handle = os.fdopen(descriptor, "rb")
                    except BaseException:
                        os.close(descriptor)
                        raise
                    info = os.fstat(handle.fileno())
                    if not stat.S_ISREG(info.st_mode):
                        raise BrowserRequestError(404, "File not found")
                    start, end, partial = parse_byte_range(self.headers.get("Range"), info.st_size)
                except BrowserRequestError:
                    if handle:
                        handle.close()
                    raise
                except OSError as err:
                    if handle:
                        handle.close()
                    raise BrowserRequestError(404, "File not available") from err
                length = end - start + 1 if info.st_size else 0
                try:
                    self.send_response(206 if partial else 200)
                    self.send_header("Content-Type", mimetypes.guess_type(path.name)[0] or "application/octet-stream")
                    self.send_header("Content-Length", str(length))
                    self.send_header("Accept-Ranges", "bytes")
                    self.send_header("Last-Modified", formatdate(info.st_mtime, usegmt=True))
                    fallback = path.name.encode("ascii", "ignore").decode("ascii")
                    fallback = fallback.replace('"', "").replace("\\", "").replace("\r", "").replace("\n", "") or "recording"
                    self.send_header("Content-Disposition", f"inline; filename=\"{fallback}\"; filename*=UTF-8''{quote(path.name)}")
                    self.send_header("Cache-Control", "private, no-cache")
                    if partial:
                        self.send_header("Content-Range", f"bytes {start}-{end}/{info.st_size}")
                    self._security_headers()
                    self.end_headers()
                    if head_only or not length:
                        return
                    handle.seek(start)
                    remaining = length
                    while remaining:
                        chunk = handle.read(min(1024 * 1024, remaining))
                        if not chunk:
                            break
                        self.wfile.write(chunk)
                        remaining -= len(chunk)
                finally:
                    handle.close()

        return Handler

    def start(self) -> None:
        try:
            self.server = ThreadingHTTPServer((self.host, self.port), self._handler())
        except OSError as err:
            raise ConfigError(f"Recording browser cannot listen on Ingress port {self.port}: {err}") from err
        self.port = self.server.server_address[1]
        self.server.daemon_threads = True
        self.index.start()
        self.thread = threading.Thread(target=self.server.serve_forever, name="recording-browser", daemon=True)
        self.thread.start()
        LOG.info("Recording browser ready on Home Assistant Ingress port %d", self.port)

    def stop(self) -> None:
        if self.server:
            self.server.shutdown()
            self.server.server_close()
        if self.thread:
            self.thread.join(timeout=5)
        self.index.stop()

    def delete_recording(self, camera: str, relative: str) -> None:
        root = self.camera_roots.get(camera)
        if root is None or not self.index.indexed(camera, relative):
            raise BrowserRequestError(404, "Recording not found")
        try:
            path = resolve_browser_path(root, relative, expected="file")
            info = path.lstat()
            if not stat.S_ISREG(info.st_mode) or not is_video_file(path):
                raise BrowserRequestError(400, "Only indexed video recordings can be deleted")
            if info.st_mtime > time.time() - INDEX_SETTLE_SECONDS:
                raise BrowserRequestError(409, "Recording is still being written")
            path.unlink()
        except BrowserRequestError as err:
            if err.status == 404:
                self.index.remove(camera, relative)
            raise
        except FileNotFoundError:
            self.index.remove(camera, relative)
            raise BrowserRequestError(404, "Recording not found") from None
        except OSError as err:
            raise BrowserRequestError(500, f"Recording cannot be deleted: {err.strerror or err}") from err
        self.index.remove(camera, relative)


class Supervisor:
    def __init__(
        self, config: RuntimeConfig, config_path: Path, openssl_config: Path,
        browser: RecordingBrowser | None = None,
    ):
        self.config = config
        self.config_path = config_path
        self.openssl_config = openssl_config
        self.browser = browser
        self.stop = threading.Event()
        self.child: subprocess.Popen[str] | None = None

    def terminate(self, *_args: object) -> None:
        self.stop.set()
        if self.child and self.child.poll() is None:
            self.child.terminate()

    def run(self) -> int:
        storage = self.config.raw["storage"]
        threshold = storage["minimum_free_space_gb"] * 1024**3
        blocked = False
        last_retention = 0.0
        exit_code = 0
        while not self.stop.is_set():
            available = free_bytes(self.config.recording_root)
            should_block = storage["stop_uploads_below_free_space"] and available < threshold
            if should_block:
                if not blocked:
                    LOG.error(
                        "FREE SPACE SAFETY STOP: %.2f GiB is below the configured %d GiB; FTP service stopped",
                        available / 1024**3, storage["minimum_free_space_gb"],
                    )
                    blocked = True
                if self.child and self.child.poll() is None:
                    self.child.terminate()
                    try:
                        self.child.wait(timeout=15)
                    except subprocess.TimeoutExpired:
                        self.child.kill()
                self.stop.wait(30)
                continue
            if blocked:
                LOG.warning("Free space recovered to %.2f GiB; restarting FTP service", available / 1024**3)
                blocked = False
            if not self.child or self.child.poll() is not None:
                if self.child and self.child.returncode not in (None, 0, -signal.SIGTERM):
                    LOG.error("vsftpd exited unexpectedly with code %s", self.child.returncode)
                    exit_code = self.child.returncode or 1
                    break
                environment = os.environ.copy()
                environment["OPENSSL_CONF"] = str(self.openssl_config)
                self.child = subprocess.Popen(
                    ["/usr/sbin/vsftpd", str(self.config_path)], text=True, env=environment,
                )
            now = time.time()
            retention = self.config.raw["retention_days"]
            if retention and now - last_retention >= 3600:
                count, size = remove_expired_files(self.config.recording_root, retention)
                if count:
                    LOG.info("Retention removed %d files and reclaimed %.2f MiB", count, size / 1024**2)
                last_retention = now
            self.stop.wait(30)
        if self.child and self.child.poll() is None:
            self.child.terminate()
            try:
                self.child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                self.child.kill()
        if self.browser:
            self.browser.stop()
        return exit_code


def load_options(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as err:
        raise ConfigError(f"Cannot read Home Assistant options: {err}") from err
    if not isinstance(value, dict):
        raise ConfigError("Home Assistant options must be a JSON object")
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("run", "validate"), nargs="?", default="run")
    parser.add_argument("--options", type=Path, default=Path(os.environ.get("OPTIONS_PATH", "/data/options.json")))
    args = parser.parse_args()
    try:
        raw = load_options(args.options)
        level_name = str(raw.get("log_level", "info")).upper()
        logging.basicConfig(level=getattr(logging, level_name, logging.INFO), format="%(asctime)s %(levelname)s: %(message)s")
        data_dir = Path(os.environ.get("DATA_DIR", "/data"))
        ssl_dir = Path(os.environ.get("SSL_DIR", "/ssl"))
        config = prepare_runtime(raw, data_dir=data_dir, ssl_dir=ssl_dir)
        available = free_bytes(config.recording_root)
        LOG.info("Reolink FTPS Server %s", VERSION)
        LOG.info("Recording root: %s", config.recording_root)
        LOG.info("Storage anchor: %s (device %s, %.2f GiB available)", config.anchor, config.recording_root.stat().st_dev, available / 1024**3)
        LOG.info("FTPS required: %s; plain FTP allowed: %s", raw["tls"]["require_tls"], raw["tls"]["allow_plain_ftp"])
        if raw["tls"]["allow_plain_ftp"]:
            LOG.warning("PLAIN FTP IS ENABLED: credentials and recordings can cross the network unencrypted")
        LOG.info("TLS source: %s", config.cert_source)
        LOG.info("Control port 21; passive ports 30000-30019; PASV address %s", raw["pasv_address"])
        LOG.info("Configured FTP users: %d; retention: %s", len(config.users), f"{raw['retention_days']} days" if raw["retention_days"] else "disabled")
        if args.command == "validate":
            return 0
        runtime_dir = Path("/run/reolink-ftps")
        runtime_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        provision_users(config, data_dir, runtime_dir)
        openssl_config = runtime_dir / "openssl.cnf"
        atomic_write(
            openssl_config,
            "openssl_conf = reolink_ftps_init\n\n"
            "[reolink_ftps_init]\nssl_conf = ssl_settings\n\n"
            "[ssl_settings]\nsystem_default = tls_policy\n\n"
            "[tls_policy]\nMinProtocol = TLSv1.2\nMaxProtocol = TLSv1.2\n",
            0o600,
        )
        secure_chroot = Path("/run/vsftpd/empty")
        secure_chroot.mkdir(mode=0o555, parents=True, exist_ok=True)
        os.chown(secure_chroot, 0, 0)
        secure_chroot.chmod(0o555)
        vsftpd_config = build_vsftpd_config(config, runtime_dir)
        browser = RecordingBrowser(config, data_dir=data_dir)
        browser.start()
        supervisor = Supervisor(config, vsftpd_config, openssl_config, browser)
        signal.signal(signal.SIGTERM, supervisor.terminate)
        signal.signal(signal.SIGINT, supervisor.terminate)
        return supervisor.run()
    except ConfigError as err:
        logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s: %(message)s")
        LOG.error("Configuration refused: %s", err)
        return 1
    except subprocess.CalledProcessError as err:
        LOG.error("Required command failed: %s", err.cmd[0] if isinstance(err.cmd, list) else err.cmd)
        return 1


if __name__ == "__main__":
    sys.exit(main())
